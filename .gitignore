node_modules/
.shots/
out/
*.log
.env
.env.*
.worktrees/

# The narration fixture cache: disposable, regenerated by synth.mjs/build.mjs
# (instantly from the stub, or from Sarvam within the small paid-call budget).
# Never commit it; recipes commit their own built audio (e.g. the storybook
# spread's spread.*.wav/vtt) as the real, reviewable artefact.
packages/narration/fixtures/*
!packages/narration/fixtures/README.md

# Folio build outputs: reproducible with `npm run folio -- build packages/folio/samples/<page>.html`
packages/folio/samples/*.folio.html
packages/folio/samples/*.folio.pdf
packages/folio/samples/.*.folio-src.html

# Proposal PDFs: a by-product, rebuilt by packages/recipes/proposal/build.mjs --pdf
packages/recipes/proposal/examples/*/*.pdf
packages/recipes/proposal/examples/*/.*.proposal-src.html

# Goan stories: source photos never enter git (docs/requests/2026-09-26-goan-stories-loop.md)
stories/*/source/

# Wrangler local state
.wrangler/
