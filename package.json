{
  "name": "susegad-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Beautiful and comfortable interfaces and documents: three registers, drawn in code, copied into your project.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/cli",
    "packages/mcp"
  ],
  "scripts": {
    "test:unit": "node --test \"packages/**/*.test.js\" \"registry/**/*.test.mjs\" \"apps/**/*.test.js\" \"apps/**/*.test.mjs\" \"sketchbook/**/*.test.js\"",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "test": "npm run test:unit && npm run test:tools",
    "serve": "node tools/serve.mjs",
    "check": "node tools/checks.mjs",
    "smoke": "node tools/smoke.mjs",
    "rigour": "node tools/rigour.mjs",
    "repo-check": "node tools/repo-check.mjs",
    "gates": "npm run test:unit && npm run test:tools && npm run repo-check",
    "gates:slice": "npm run test:unit && node tools/repo-check.mjs --tools-tests=if-changed",
    "cem": "node tools/cem.mjs",
    "skill-inventory": "node tools/skill-inventory.mjs",
    "folio": "node packages/folio/bin/folio.mjs",
    "docs:build": "node apps/docs/build.mjs",
    "deploy": "node apps/docs/build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "esbuild": "0.28.2",
    "harfbuzzjs": "1.6.2",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "sharp": "0.35.4",
    "subset-font": "2.9.0",
    "wawoff2": "2.0.1",
    "wrangler": "4.141.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sarat-asymmetrica/susegad-ui.git"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
